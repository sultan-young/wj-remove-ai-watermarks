# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-this-with-your-own-random-secret-at-least-24-chars
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Real GPU processing. mock is transport-only and NEVER removes watermarks.
WORKER_MODE=real
# Reuse your existing venv on CompShare:
PYTHON_BIN=/root/raiw-test/.venv/bin/python
HF_HOME=/root/raiw-test/model-cache
MODEL_OFFLINE=true
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=60

DEFAULT_PIPELINE=sdxl-zimage
# Enable only prepared/tested profiles. auto can select other models.
ENABLED_PIPELINES=sdxl-zimage
ENABLE_TEXT_RESTORATION=false

# Each worker loads a separate model. 4090 24GB: start with 1.
WORKER_CONCURRENCY=1
# Workers assigned round-robin, e.g. 0,1 for two GPUs; CUDA-visible device IDs of the instance.
GPU_DEVICES=0
MAX_QUEUE_SIZE=32
MAX_TASK_RECORDS=2000
TASK_TIMEOUT_SECONDS=1200
QUEUE_TIMEOUT_SECONDS=1800
WORKER_START_TIMEOUT_SECONDS=600
WORKER_RESTART_DELAY_MS=3000

DATA_DIR=./data
MAX_IMAGE_BYTES=33554432
MAX_IMAGE_PIXELS=16777216
RESULT_TTL_SECONDS=3600
URL_TIMEOUT_MS=60000
URL_MAX_REDIRECTS=3
URL_ALLOWED_PORTS=80,443
# Only enable for your trusted LAN/object store. Default blocks private/link-local/loopback.
URL_ALLOW_PRIVATE=false
