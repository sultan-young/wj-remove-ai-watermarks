# 填写你原有的真实 API 密钥，至少 24 个字符
API_KEY=replace-this-with-your-own-random-secret-at-least-24-chars

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 使用真实 GPU 处理
WORKER_MODE=real

# 复用已有 Python 虚拟环境
PYTHON_BIN=/root/raiw-test/.venv/bin/python

# Hugging Face 模型缓存
HF_HOME=/root/raiw-test/model-cache
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=60

# DiffSynth 模型目录：Z-Image、Qwen 等
DIFFSYNTH_MODEL_BASE_PATH=/root/raiw-test/model-cache/diffsynth
DIFFSYNTH_DOWNLOAD_SOURCE=huggingface

# 模型已下载，运行时使用本地文件
MODEL_OFFLINE=true
DIFFSYNTH_SKIP_DOWNLOAD=True

# 默认按照官方规则，根据图片来源选择处理管线
DEFAULT_PIPELINE=auto

# 开放全部三套管线，以及自动选择
ENABLED_PIPELINES=sdxl-zimage,qwen-zimage,chroma-zimage,auto

# 暂不启用实验性文字恢复
ENABLE_TEXT_RESTORATION=false

# 每个 worker 独立加载模型，当前 4090 24GB 保持单并发
WORKER_CONCURRENCY=1
GPU_DEVICES=0

# 排队任务数量上限
MAX_QUEUE_SIZE=32

# 内存中保留的任务记录数量上限
MAX_TASK_RECORDS=2000

# 单任务执行超时：20 分钟
TASK_TIMEOUT_SECONDS=1200

# 排队超时：30 分钟
QUEUE_TIMEOUT_SECONDS=1800

# Python worker 启动及模型预加载超时：10 分钟
WORKER_START_TIMEOUT_SECONDS=600
WORKER_RESTART_DELAY_MS=3000

# 上传文件和处理结果的存储目录
DATA_DIR=./data

# 单张输入图片最大 32 MiB
MAX_IMAGE_BYTES=33554432

# 单张输入图片最大约 1678 万像素
MAX_IMAGE_PIXELS=16777216

# 处理结果保留时间：1 小时
RESULT_TTL_SECONDS=3600

# URL 图片下载超时：60 秒
URL_TIMEOUT_MS=60000
URL_MAX_REDIRECTS=3
URL_ALLOWED_PORTS=80,443

# 禁止通过 URL 访问内网、回环及链路本地地址
URL_ALLOW_PRIVATE=false