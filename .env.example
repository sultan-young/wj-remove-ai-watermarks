# 必填。调用时放在 Authorization: Bearer 后面，至少 24 位。
# 实例上的 .env 必须有这一行。没有 .env 时 install.sh 会生成；已有 .env 但缺密钥或仍是占位符时，再跑一次 install.sh 会补上。
# 不要把 replace-this- 开头的示例值留在实例上，服务会拒绝启动。
# 手工生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-this-with-your-own-random-secret-at-least-24-chars
# 监听地址。0.0.0.0 表示接受这台机器所有网卡上的连接。
HOST=0.0.0.0
# 服务端口。其它机器用 http://这台机器的IP:8000 访问。
PORT=8000
# 日志级别：silent / fatal / error / warn / info / debug / trace
LOG_LEVEL=info

# real 做去水印。mock 只复制图片，用来测通信和队列，不去水印。
WORKER_MODE=real
# 已有的 Python 虚拟环境。服务不重装 Torch。
PYTHON_BIN=/root/raiw-test/.venv/bin/python
# 模型缓存目录。MODEL_OFFLINE=true 时缺模型会失败，不会在启动时下载。
HF_HOME=/root/raiw-test/model-cache
MODEL_OFFLINE=true
# 关闭 Hugging Face 的 Xet 下载，并限制元数据请求超时（秒）。
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=60

# 这台机器允许加载的 pipeline，逗号分隔。请求没写 pipeline 时与上游一样是 qwen-zimage，不会被改成别的。
# 没下载的 profile 从这里去掉后，请求它会直接拒绝。
ENABLED_PIPELINES=qwen-zimage,sdxl-zimage,chroma-zimage,auto

# 同时处理的图片数。每个 Worker 是独立进程，各自加载一套模型。一张 24GB 的 4090 从 1 开始。
WORKER_CONCURRENCY=1
# Worker 轮流使用的显卡编号，逗号分隔。例如两张卡写 0,1。只写 0 时多个 Worker 共用第一张卡。
GPU_DEVICES=0
# 排队上限。已满时新任务返回 429，正在计算的任务不计入这个数量。
MAX_QUEUE_SIZE=32
# 内存中保留的任务记录上限，含已完成的。达到后需删除旧任务才能继续提交。
MAX_TASK_RECORDS=2000
# 单张图开始计算后的最长时间（秒）。超时会结束对应 Worker 并重新加载模型。
TASK_TIMEOUT_SECONDS=1200
# 排队最长等待（秒）。Worker 一直没就绪时任务以 QUEUE_TIMEOUT 失败，不会无限排队。
QUEUE_TIMEOUT_SECONDS=1800
# 加载模型的最长时间（秒）。
WORKER_START_TIMEOUT_SECONDS=600
# Worker 启动失败后，隔多少毫秒再试。
WORKER_RESTART_DELAY_MS=3000

# 任务文件和结果目录。一个目录只给一个服务实例使用。
DATA_DIR=./data
# 单张图片最大字节数。33554432 是 32MB。
MAX_IMAGE_BYTES=33554432
# 单张图片最大像素数。16777216 大约是 4096×4096。
MAX_IMAGE_PIXELS=16777216
# 成功结果保留秒数。3600 是 1 小时，过期后下载返回 410。
RESULT_TTL_SECONDS=3600
# 用 URL 提交图片时，下载最长毫秒数。
URL_TIMEOUT_MS=60000
# URL 最多跟随几次重定向。
URL_MAX_REDIRECTS=3
# URL 允许的端口，逗号分隔。
URL_ALLOWED_PORTS=80,443
# 是否允许下载内网、本机和链路本地地址。只在图片源是可信内网时改为 true。
URL_ALLOW_PRIVATE=false
